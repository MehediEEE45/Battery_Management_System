# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# --- MQTT (HiveMQ Cloud, native TLS port) ---
MQTT_URL=mqtts://0d34f5789e1e4a669367abfe5bd45b15.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=battery
MQTT_PASSWORD=change_me

# Topic filters the bridge subscribes to
MQTT_TOPIC_FILTER=energy/+/+/telemetry
MQTT_TOPIC_FILTER_2=smartpower/+/data
MQTT_TOPIC_FILTER_3=battery/data

# Fixed client ID enables a persistent MQTT session (clean:false), so
# HiveMQ queues messages published while this process is offline/asleep
# and redelivers them on reconnect. Leave unset for local/throwaway runs;
# always set this when deployed (e.g. Render) so restarts don't lose data.
MQTT_CLIENT_ID=bms-render-bridge-1

# --- HTTP server ---
# Most cloud hosts (Railway/Render) inject PORT automatically — leave unset there.
PORT=3000

# --- Local SQLite cache (kept alongside MongoDB) ---
DB_FILE=telemetry.db

# --- MongoDB Atlas ---
# Standard SRV form (works everywhere except DNS-restricted sandboxes):
MONGO_URI=mongodb+srv://<db_username>:<db_password>@bmscluster.geholqc.mongodb.net/?appName=BMSCluster
MONGO_DB=battery_monitor
MONGO_COLLECTION=telemetry
# 0 = no TTL/expiry; >0 = auto-delete documents after this many days
MONGO_TTL_DAYS=30
